{
  "expo": {
    "name": "Aster",
    "slug": "dashboard",
    "version": "1.0.0",
    "platforms": ["web"],
    "scheme": "aster",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.png"
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
